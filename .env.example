# ─────────────────────────────────────────────────────────────
# AgentMatch environment variables
#
# Copy this file to `.env.local` and fill in your Supabase keys:
#   cp .env.example .env.local
#
# Get both values from: Supabase Dashboard → Project Settings → API
#
# NOTE: If you leave these unset, the app runs against an in-memory
# mock database seeded with sample data — no setup required.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon (public) API key — safe for the browser.
# NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
