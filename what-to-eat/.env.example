# Copy to .env and fill in what you have. Every value is optional: without them the app runs
# in guest mode with analytics and crash reporting switched off.
# For EAS builds, add the same values with `npx eas-cli env:create` (see RELEASE.md).

# Supabase: Project Settings > API. The publishable (anon) key is safe in the app; Row Level
# Security protects the data. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog analytics: Project settings > Project API key (public by design).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting: Project settings > Client Keys (DSN). Public by design.
EXPO_PUBLIC_SENTRY_DSN=
